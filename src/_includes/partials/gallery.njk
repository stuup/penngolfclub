{#- Set `gallery` = [{ src, alt }] before including. Opens in a lightbox. -#}
<div class="not-prose grid grid-cols-2 gap-3 sm:grid-cols-3" data-gallery>
  {%- for g in gallery %}
  <a href="{{ g.src }}" class="group relative block overflow-hidden rounded-xl {{ 'col-span-2 row-span-2' if loop.first and gallery.length > 4 else '' }}">
    <img src="{{ g.src }}" alt="{{ g.alt }}" class="aspect-[4/3] h-full w-full object-cover transition duration-500 group-hover:scale-105" sizes="(min-width: 1024px) 33vw, 50vw">
    <span class="absolute inset-0 bg-heath-950/0 transition group-hover:bg-heath-950/15"></span>
  </a>
  {%- endfor %}
</div>
