<article class="card group relative flex flex-col overflow-hidden">
  {%- if post.data.image %}
  <img src="{{ post.data.image }}" alt="" class="aspect-[16/9] w-full object-cover" sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw">
  {%- endif %}
  <div class="flex flex-1 flex-col p-6">
    <p class="text-xs font-semibold tracking-wider text-crest-500 uppercase"><time datetime="{{ post.date | isoDay }}">{{ post.date | dateMedium }}</time>{% if post.data.category %} · {{ post.data.category }}{% endif %}</p>
    <h3 class="mt-2 text-xl font-semibold text-heath-900">
      <a href="{{ post.url }}" class="after:absolute after:inset-0 group-hover:text-crest-600">{{ post.data.title }}</a>
    </h3>
    <p class="mt-2 flex-1 text-heath-700">{{ post.data.summary }}</p>
    <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-crest-600">Read more {% icon "arrowRight", "size-4 transition-transform group-hover:translate-x-1" %}</span>
  </div>
</article>
