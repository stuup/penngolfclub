{#- Set `doc` = { title, url, type } before including. -#}
<a href="{{ doc.url }}" class="group not-prose flex items-center gap-4 rounded-xl bg-white p-4 ring-1 ring-heath-950/10 transition hover:ring-crest-400" download>
  <span class="flex size-11 shrink-0 items-center justify-center rounded-lg bg-crest-100 text-crest-600">{% icon "download", "size-5" %}</span>
  <span class="min-w-0 flex-1">
    <span class="block font-semibold text-heath-900 group-hover:text-crest-600">{{ doc.title }}</span>
    <span class="text-sm text-heath-600">{{ doc.type }} download</span>
  </span>
</a>
