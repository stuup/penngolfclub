<section class="container-site mt-20">
  <div class="relative isolate overflow-hidden rounded-3xl bg-heath-900 px-6 py-12 sm:px-12 lg:flex lg:items-center lg:justify-between lg:gap-10">
    <img src="/assets/brand/penn-golf-club-crest-white.svg" alt="" class="absolute -top-16 -right-16 -z-10 size-72 opacity-[0.07]" eleventy:ignore>
    <div>
      <h2 class="font-display text-3xl font-semibold text-white sm:text-4xl">{{ cta.title or "Ready to play Penn?" }}</h2>
      <p class="mt-3 max-w-xl text-white/75">{{ cta.text or "Book online in a couple of clicks, or call the Golf Shop on 01902 330472 to check availability." }}</p>
    </div>
    <div class="mt-8 flex shrink-0 flex-wrap gap-3 lg:mt-0">
      <a href="{{ cta.url or site.links.bookTeeTime }}" class="btn-primary px-6 py-3 text-base">{{ cta.label or "Book a tee time" }}</a>
      <a href="{{ cta.url2 or '/contact/' }}" class="btn-ghost-light px-6 py-3 text-base">{{ cta.label2 or "Contact us" }}</a>
    </div>
  </div>
</section>
