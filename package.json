{
  "name": "penngolfclub",
  "version": "1.0.0",
  "private": true,
  "description": "Penn Golf Club website — Eleventy + Tailwind CSS, hosted on Netlify",
  "type": "module",
  "scripts": {
    "dev": "npm-run-all --parallel dev:*",
    "dev:css": "tailwindcss -i src/assets/css/main.css -o _site/assets/css/main.css --watch",
    "dev:11ty": "eleventy --serve --quiet",
    "build": "npm run build:11ty && npm run build:css",
    "build:11ty": "eleventy",
    "build:css": "tailwindcss -i src/assets/css/main.css -o _site/assets/css/main.css --minify",
    "logo": "node tools/logo/generate-logo.mjs src/assets/brand"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-img": "^6.0.4",
    "@11ty/eleventy-plugin-rss": "^2.0.4",
    "@fontsource/arimo": "^5.1.0",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "netlify-plugin-cache": "^1.0.3",
    "npm-run-all2": "^9.0.3",
    "opentype.js": "^1.3.4",
    "tailwindcss": "^4.3.3"
  }
}
